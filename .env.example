# Copia este archivo a ".env" (ya está en .gitignore) y completa tus propios
# datos de conexión. Nunca escribas credenciales reales en este archivo
# .env.example ni en ningún archivo que se vaya a commitear.

# BD de origen (dev_inclub) — SOLO LECTURA. Nunca correr Alembic contra esta.
SOURCE_DB_HOST=
SOURCE_DB_PORT=
SOURCE_DB_NAME=
SOURCE_DB_USER=
SOURCE_DB_PASSWORD=
SOURCE_DB_SSLMODE=disable

# BD de resultados (propia del microservicio) — lectura y escritura.
RESULTS_DB_HOST=
RESULTS_DB_PORT=
RESULTS_DB_NAME=
RESULTS_DB_USER=
RESULTS_DB_PASSWORD=
RESULTS_DB_SSLMODE=disable
